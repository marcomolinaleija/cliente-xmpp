# Incremental on the inspected runtime: preserve every existing bridge feature.
ARG BRIDGE_IMAGE=cliente-xmpp-bridge:inbound-pool-20261020
ARG BUILD_IMAGE=cliente-xmpp-bridge:linking-builder-20261020
FROM ${BRIDGE_IMAGE} AS patched
USER root
COPY patch_slidge_recovery.py smoke_bridge_recovery_runtime.py slidge-watchdog /opt/recovery-tools/
RUN cp /venv/lib/python3.13/site-packages/slidge_whatsapp/session.go /opt/recovery-tools/session.before.go && \
    python -B /opt/recovery-tools/patch_slidge_recovery.py /venv/lib/python3.13/site-packages && \
    python -B /opt/recovery-tools/patch_slidge_recovery.py /venv/lib/python3.13/site-packages

FROM ${BUILD_IMAGE} AS builder
ENV GOMAXPROCS=2
COPY --from=patched /venv/lib/python3.13/site-packages/slidge_whatsapp /integration/slidge_whatsapp
COPY --from=patched /opt/recovery-tools/session.before.go /tmp/session.before.go
COPY bridge_payload_recovery_test.go /integration/slidge_whatsapp/
COPY check_bridge_go_report.py /opt/recovery-tools/
COPY gopy_whatsapp_exports.map /tmp/gopy_whatsapp_exports.map
WORKDIR /integration/slidge_whatsapp
# Same toolchain/module overrides as the deployed inbound image, not an upgrade.
RUN go mod edit -go=1.26.4 -require=github.com/pion/webrtc/v4@v4.2.15 -replace=go.mau.fi/whatsmeow=/opt/bridge-whatsmeow && \
    go mod tidy && gofmt -w session.go can_read_state_recovery.go bridge_payload_recovery_test.go
# Prove the payload cases reject the original native method, then restore the fix.
RUN cp session.go /tmp/session.after.go && cp /tmp/session.before.go session.go && \
    (go test -p 2 -json -mod=mod -run '^TestCANPayloadComposition$' . >/tmp/recovery-baseline.jsonl; echo $? >/tmp/recovery-baseline.status) && \
    cp /tmp/session.after.go session.go && \
    python3 -c 'import json;from pathlib import Path;r=[json.loads(l) for l in Path("/tmp/recovery-baseline.jsonl").read_text().splitlines()];assert Path("/tmp/recovery-baseline.status").read_text().strip()=="1";assert any(x.get("Action")=="fail" and x.get("Test","").startswith("TestCANPayloadComposition/") for x in r);print("Original payload composition rejected by native regression cases")'
RUN (go test -p 2 -json -mod=mod . ./voicecore/... >/tmp/recovery-go.jsonl; echo $? >/tmp/recovery-go.status) && \
    python3 /opt/recovery-tools/check_bridge_go_report.py /tmp/recovery-go.jsonl "$(cat /tmp/recovery-go.status)" && \
    (go test -p 2 -json -mod=mod -race . ./voicecore/... >/tmp/recovery-race.jsonl; echo $? >/tmp/recovery-race.status) && \
    python3 /opt/recovery-tools/check_bridge_go_report.py /tmp/recovery-race.jsonl "$(cat /tmp/recovery-race.status)"
RUN cd generated && go build -p 2 -mod=mod -buildmode=c-shared -tags "mupdf extlib" \
    -ldflags="-s -w -extldflags=-Wl,--version-script=/tmp/gopy_whatsapp_exports.map" \
    -o _whatsapp.cpython-313-x86_64-linux-gnu.so .

FROM patched
COPY --from=builder /integration/slidge_whatsapp/generated/_whatsapp.cpython-313-x86_64-linux-gnu.so /venv/lib/python3.13/site-packages/slidge_whatsapp/generated/
COPY --from=builder /integration/slidge_whatsapp/session.go /integration/slidge_whatsapp/can_read_state_recovery.go /venv/lib/python3.13/site-packages/slidge_whatsapp/
COPY --from=builder /tmp/recovery-go.jsonl /tmp/recovery-race.jsonl /tmp/recovery-baseline.jsonl /opt/recovery-tools/
USER slidge
RUN --network=none CAN_VOICE_ENABLE=0 python -B /opt/recovery-tools/smoke_bridge_recovery_runtime.py && \
    CAN_VOICE_ENABLE=0 python -B /opt/inbound-tools/smoke_bridge_linking_runtime.py && \
    CAN_VOICE_ENABLE=0 python -B /opt/inbound-tools/smoke_bridge_muc_history_runtime.py
LABEL org.can.whatsapp.recovery="1"
