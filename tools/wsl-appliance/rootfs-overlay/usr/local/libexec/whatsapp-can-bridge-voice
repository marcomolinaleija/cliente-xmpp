#!/usr/bin/env bash
# Local voice configuration. Never mount the CA private key in Slidge.
set -euo pipefail
config_dir="${WHATSAPP_CAN_CONFIG_DIR:-/etc/whatsapp-can-bridge}"
voice_tls="$config_dir/voice-tls"
control=/usr/local/sbin/whatsapp-can-bridge
image_manager=/usr/local/libexec/whatsapp-can-bridge-image

require_root() {
    [[ "$(id -u)" == 0 ]] || { echo "Se requiere root." >&2; return 1; }
}

prepare_tls() {
    local ca="$config_dir/tls" temporary
    [[ -s "$ca/ca.crt" && -s "$ca/ca.key" ]] || return 1
    [[ ! -L "$voice_tls" ]] || return 1
    [[ ! -L "$voice_tls/server.crt" && ! -L "$voice_tls/server.key" ]] || return 1
    install -d -o root -g 10000 -m 0750 "$voice_tls"
    if [[ -s "$voice_tls/server.crt" && -s "$voice_tls/server.key" ]] &&
        openssl verify -CAfile "$ca/ca.crt" "$voice_tls/server.crt" >/dev/null 2>&1 &&
        openssl x509 -in "$voice_tls/server.crt" -checkend 2592000 -checkip 127.0.0.1 -noout >/dev/null &&
        [[ "$(openssl x509 -in "$voice_tls/server.crt" -pubkey -noout | sha256sum)" == \
           "$(openssl pkey -in "$voice_tls/server.key" -pubout 2>/dev/null | sha256sum)" ]]; then
        chown root:10000 "$voice_tls/server.key" "$voice_tls/server.crt"
        chmod 0640 "$voice_tls/server.key"
        chmod 0644 "$voice_tls/server.crt"
        return
    fi
    temporary="$(mktemp -d "$config_dir/.voice-tls.XXXXXX")"
    chmod 0700 "$temporary"
    if ! (
        set -e
        umask 077
        openssl req -new -newkey rsa:3072 -nodes -sha256 \
            -subj '/CN=WhatsApp CAN Local Voice' \
            -keyout "$temporary/server.key" -out "$temporary/server.csr" >/dev/null 2>&1 &&
        printf '%s\n' 'subjectAltName=IP:127.0.0.1' 'basicConstraints=critical,CA:FALSE' \
            'keyUsage=critical,digitalSignature,keyEncipherment' 'extendedKeyUsage=serverAuth' \
            > "$temporary/server.ext" &&
        openssl x509 -req -sha256 -days 825 -in "$temporary/server.csr" \
            -CA "$ca/ca.crt" -CAkey "$ca/ca.key" -set_serial "0x$(openssl rand -hex 16)" \
            -extfile "$temporary/server.ext" -out "$temporary/server.crt" >/dev/null 2>&1 &&
        openssl verify -CAfile "$ca/ca.crt" "$temporary/server.crt" >/dev/null &&
        install -o root -g 10000 -m 0640 "$temporary/server.key" "$voice_tls/server.key" &&
        install -o root -g 10000 -m 0644 "$temporary/server.crt" "$voice_tls/server.crt"
    ); then
        rm -f -- "$temporary/server.key" "$temporary/server.csr" "$temporary/server.ext" "$temporary/server.crt"
        rmdir -- "$temporary"
        return 1
    fi
    rm -f -- "$temporary/server.key" "$temporary/server.csr" "$temporary/server.ext" "$temporary/server.crt"
    rmdir -- "$temporary"
}

write_environment() {
    cat <<EOF
CAN_VOICE_ENABLE=1
CAN_VOICE_URL=wss://127.0.0.1:8766/voice/v1
CAN_VOICE_BIND=127.0.0.1
CAN_VOICE_PORT=8766
CAN_VOICE_HOME=/var/lib/slidge
CAN_VOICE_CERT=/run/can-voice-tls/server.crt
CAN_VOICE_KEY=/run/can-voice-tls/server.key
EOF
}

check_image() {
    local image_id
    image_id="$("$image_manager" status | jq -er '.image_id')" || return 1
    # No accounts, persistent volumes or external network in the capability check.
    podman run --rm --pull=never --network none --env CAN_VOICE_ENABLE=0 \
        --entrypoint python "$image_id" -B /opt/voice-tools/smoke_voice_integration.py
}

smoke_voice() {
    local response
    response="$(curl --silent --show-error --max-time 5 \
        --cacert "$config_dir/tls/ca.crt" -o /dev/null -w '%{http_code}' \
        https://127.0.0.1:8766/voice/v1)" || return 1
    # An anonymous request must not obtain a voice channel.
    [[ "$response" == 400 || "$response" == 403 ]]
}

enable_voice() {
    check_image || { echo "La imagen instalada no ofrece voz compatible; no se modificó la configuración." >&2; return 1; }
    prepare_tls || return 1
    set_enabled 1 || return 1
    if ! systemctl restart whatsapp-can-slidge.service || ! "$control" smoke; then
        echo "Voz sigue habilitada, pero su comprobación falló. Revisa los servicios y certificados." >&2
        return 1
    fi
    echo "Voz local habilitada. Comprueba audio en ambos sentidos con un contacto de prueba."
}

set_enabled() {
    local value="$1" temporary environment="$config_dir/environment"
    [[ "$value" == 1 ]] || { echo 'Voz es una función obligatoria del appliance.' >&2; return 1; }
    [[ -f "$environment" && ! -L "$environment" ]] || return 1
    [[ "$(grep -c '^CAN_VOICE_ENABLE=' "$environment")" == 1 ]] || return 1
    temporary="$(mktemp "$config_dir/.voice-environment.XXXXXX")"
    if ! { sed "s/^CAN_VOICE_ENABLE=.*/CAN_VOICE_ENABLE=$value/" "$environment" > "$temporary" &&
        chmod 0600 "$temporary" && mv -- "$temporary" "$environment"; }; then
        rm -f -- "$temporary"
        return 1
    fi
}

main() {
    require_root
    case "${1:-status}" in
        prepare) check_image && prepare_tls ;;
        environment) write_environment ;;
        smoke) smoke_voice ;;
        enable) enable_voice ;;
        disable) echo 'Voz es una función obligatoria del appliance y no se desactiva.' >&2; return 1 ;;
        required) [[ -f "$config_dir/environment" && ! -L "$config_dir/environment" ]] && grep -qx 'CAN_VOICE_ENABLE=1' "$config_dir/environment" ;;
        status)
            if main required && smoke_voice; then echo enabled
            else echo 'Voz requerida; todavía no disponible.' >&2; return 1; fi
            ;;
        *) return 64 ;;
    esac
}
if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then main "$@"; fi
