ARG BASE_IMAGE=ghcr.io/marcomolinaleija/cliente-xmpp-bridge:v23@sha256:44f5a5a3ba491bfab28fb280d531d3be535e4628149ec705ff6ee472e1cadb0f

FROM ${BASE_IMAGE} AS patched

USER root
COPY deepgram_transcription.py /venv/lib/python3.13/site-packages/slidge_whatsapp/deepgram_transcription.py
COPY patch_slidge_whatsapp_admin_commands.py /tmp/patch_admin_commands.py
COPY patch_slidge_whatsapp_sticker_accessibility.py /tmp/patch_sticker_accessibility.py
RUN python -B /tmp/patch_admin_commands.py \
        /venv/lib/python3.13/site-packages --no-backup && \
    python -B /tmp/patch_sticker_accessibility.py \
        /venv/lib/python3.13/site-packages --no-backup && \
    python -m compileall -q \
        /venv/lib/python3.13/site-packages/slidge_whatsapp/deepgram_transcription.py \
        /venv/lib/python3.13/site-packages/slidge_whatsapp/mixins.py \
        /venv/lib/python3.13/site-packages/slidge_whatsapp/session.py \
        /venv/lib/python3.13/site-packages/slidge/core/mixins/attachment.py && \
    rm /tmp/patch_admin_commands.py /tmp/patch_sticker_accessibility.py

FROM golang:1.25-trixie AS go_builder

RUN apt-get update -y && \
    apt-get install -y --no-install-recommends libmupdf-dev && \
    rm -rf /var/lib/apt/lists/*

COPY --from=patched /usr/local/include/python3.13 /usr/local/include/python3.13
COPY --from=patched /usr/local/lib/libpython3.13.so.1.0 /usr/local/lib/libpython3.13.so.1.0
RUN ln -s libpython3.13.so.1.0 /usr/local/lib/libpython3.13.so

COPY --from=patched /venv/lib/python3.13/site-packages/slidge_whatsapp /src/slidge_whatsapp
COPY bridge_sticker_accessibility_test.go /src/slidge_whatsapp/sticker_accessibility_test.go
COPY gopy_whatsapp_exports.map /tmp/gopy_whatsapp_exports.map

WORKDIR /src/slidge_whatsapp
RUN gofmt -w event.go sticker_accessibility_test.go && \
    go test . && \
    go test -race . && \
    rm sticker_accessibility_test.go && \
    cd generated && \
    go build -buildmode=c-shared -tags "mupdf extlib" \
        -ldflags="-s -w -extldflags=-Wl,--version-script=/tmp/gopy_whatsapp_exports.map" \
        -o _whatsapp.cpython-313-x86_64-linux-gnu.so .

FROM patched

COPY --from=go_builder \
    /src/slidge_whatsapp/event.go \
    /venv/lib/python3.13/site-packages/slidge_whatsapp/event.go
COPY --from=go_builder \
    /src/slidge_whatsapp/generated/_whatsapp.cpython-313-x86_64-linux-gnu.so \
    /venv/lib/python3.13/site-packages/slidge_whatsapp/generated/_whatsapp.cpython-313-x86_64-linux-gnu.so
COPY smoke_bridge_admin_commands_runtime.py /tmp/smoke_admin_commands.py
COPY smoke_bridge_sticker_accessibility_runtime.py /tmp/smoke_sticker_accessibility.py
RUN python -B /tmp/smoke_admin_commands.py && \
    python -B /tmp/smoke_sticker_accessibility.py && \
    rm /tmp/smoke_admin_commands.py /tmp/smoke_sticker_accessibility.py

USER slidge
