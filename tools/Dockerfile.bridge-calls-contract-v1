ARG BASE_IMAGE=ghcr.io/marcomolinaleija/cliente-xmpp-bridge:v25@sha256:5e87afab38d86d8b80a4a6b6855973ab7c79205919fe165654eb884de1c79d30

FROM ${BASE_IMAGE} AS patched

USER root
COPY patch_slidge_whatsapp_call_contract.py /tmp/patch_call_contract.py
RUN python -B /tmp/patch_call_contract.py /venv/lib/python3.13/site-packages --no-backup && \
    python -m compileall -q /venv/lib/python3.13/site-packages/slidge_whatsapp/session.py && \
    rm /tmp/patch_call_contract.py

FROM golang:1.25-trixie AS go_builder

RUN apt-get update -y && \
    apt-get install -y --no-install-recommends libmupdf-dev && \
    rm -rf /var/lib/apt/lists/*

COPY --from=patched /usr/local/include/python3.13 /usr/local/include/python3.13
COPY --from=patched /usr/local/lib/libpython3.13.so.1.0 /usr/local/lib/libpython3.13.so.1.0
RUN ln -s libpython3.13.so.1.0 /usr/local/lib/libpython3.13.so

COPY --from=patched /venv/lib/python3.13/site-packages/slidge_whatsapp /src/slidge_whatsapp
COPY bridge_calls_contract_test.go /src/slidge_whatsapp/calls_contract_test.go
COPY gopy_whatsapp_exports.map /tmp/gopy_whatsapp_exports.map

WORKDIR /src/slidge_whatsapp
RUN gofmt -w event.go session.go generated/whatsapp.go calls_contract_test.go && \
    go test . && \
    go test -race . && \
    rm calls_contract_test.go && \
    cd generated && \
    go build -buildmode=c-shared -tags "mupdf extlib" \
        -ldflags="-s -w -extldflags=-Wl,--version-script=/tmp/gopy_whatsapp_exports.map" \
        -o _whatsapp.cpython-313-x86_64-linux-gnu.so .

FROM patched

COPY --from=go_builder /src/slidge_whatsapp/event.go /venv/lib/python3.13/site-packages/slidge_whatsapp/event.go
COPY --from=go_builder /src/slidge_whatsapp/session.go /venv/lib/python3.13/site-packages/slidge_whatsapp/session.go
COPY --from=go_builder /src/slidge_whatsapp/generated/whatsapp.go /venv/lib/python3.13/site-packages/slidge_whatsapp/generated/whatsapp.go
COPY --from=go_builder /src/slidge_whatsapp/generated/_whatsapp.cpython-313-x86_64-linux-gnu.so /venv/lib/python3.13/site-packages/slidge_whatsapp/generated/_whatsapp.cpython-313-x86_64-linux-gnu.so
COPY smoke_bridge_calls_contract_runtime.py /tmp/smoke_calls_contract.py
RUN python -B /tmp/smoke_calls_contract.py && rm /tmp/smoke_calls_contract.py

USER slidge
