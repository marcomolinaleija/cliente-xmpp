# Local candidate contains the already validated Info and group-read changes.
ARG BASE_IMAGE=cliente-xmpp-bridge:read-state-v33-candidate
FROM ${BASE_IMAGE} AS patched
USER root
COPY patch_slidge_call_duration_v33.py patch_slidge_call_recovery_v33.py bridge_call_recovery_v33.go patch_slidge_message_info_v33.py /tmp/
RUN python -B /tmp/patch_slidge_call_duration_v33.py /venv/lib/python3.13/site-packages && \
    python -B /tmp/patch_slidge_call_duration_v33.py /venv/lib/python3.13/site-packages && \
    python -B /tmp/patch_slidge_call_recovery_v33.py /venv/lib/python3.13/site-packages && \
    python -B /tmp/patch_slidge_call_recovery_v33.py /venv/lib/python3.13/site-packages

FROM golang:1.25-trixie AS go_builder
ENV GOMAXPROCS=2 GOFLAGS=-p=2 GOMEMLIMIT=2GiB
RUN apt-get update -y && apt-get install -y --no-install-recommends libmupdf-dev && \
    rm -rf /var/lib/apt/lists/*
COPY --from=patched /usr/local/include/python3.13 /usr/local/include/python3.13
COPY --from=patched /usr/local/lib/libpython3.13.so.1.0 /usr/local/lib/libpython3.13.so.1.0
RUN ln -s libpython3.13.so.1.0 /usr/local/lib/libpython3.13.so
COPY --from=patched /venv/lib/python3.13/site-packages/slidge_whatsapp /src/slidge_whatsapp
COPY bridge_message_info_test.go bridge_read_state_test.go bridge_call_records_v27_test.go bridge_call_duration_v33_test.go bridge_call_recovery_v33_test.go /src/slidge_whatsapp/
COPY gopy_whatsapp_exports.map /tmp/gopy_whatsapp_exports.map
WORKDIR /src/slidge_whatsapp
RUN gofmt -w event.go session.go can_call_recovery.go *_test.go && \
    CAN_CALL_FIXTURE=/tmp/call-history-fixture.json go test -v . && go test -race . && \
    rm *_test.go && cd generated && \
    go build -buildmode=c-shared -tags "mupdf extlib" \
      -ldflags="-s -w -extldflags=-Wl,--version-script=/tmp/gopy_whatsapp_exports.map" \
      -o _whatsapp.cpython-313-x86_64-linux-gnu.so .

FROM patched
COPY --from=go_builder /src/slidge_whatsapp/event.go /src/slidge_whatsapp/session.go /venv/lib/python3.13/site-packages/slidge_whatsapp/
COPY --from=go_builder /src/slidge_whatsapp/generated/_whatsapp.cpython-313-x86_64-linux-gnu.so /venv/lib/python3.13/site-packages/slidge_whatsapp/generated/
COPY --from=go_builder /tmp/call-history-fixture.json /opt/can-tests/
COPY smoke_bridge_call_duration_v33_runtime.py /opt/can-tests/
RUN chmod 0644 /opt/can-tests/call-history-fixture.json /opt/can-tests/smoke_bridge_call_duration_v33_runtime.py
USER slidge
RUN python -B /opt/can-tests/smoke_bridge_call_duration_v33_runtime.py && \
    python -B /opt/can-tests/smoke_bridge_message_info_runtime.py && \
    python -B /opt/can-tests/smoke_bridge_read_state_runtime.py && \
    python -B /opt/can-tests/smoke_bridge_avatar_safety_runtime.py && \
    python -B /opt/can-tests/smoke_bridge_audio_modes_runtime.py && \
    python -B /opt/can-tests/smoke_bridge_native_sticker_pack_runtime.py && \
    python -B /opt/can-tests/smoke_bridge_sticker_delivery_runtime.py && \
    python -B /opt/can-tests/smoke_bridge_sticker_accessibility_runtime.py && \
    python -B /opt/can-tests/smoke_bridge_stickers_runtime.py && \
    python -B /opt/can-tests/smoke_bridge_no_auto_join_runtime.py
