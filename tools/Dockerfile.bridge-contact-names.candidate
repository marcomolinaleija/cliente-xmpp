ARG BASE_IMAGE=ghcr.io/marcomolinaleija/cliente-xmpp-bridge:v10

FROM ${BASE_IMAGE} AS patched

USER root
COPY patch_slidge_whatsapp_contact_names.py /tmp/patch_contact_names.py
RUN python -B /tmp/patch_contact_names.py /venv/lib/python3.13/site-packages \
        --no-backup && \
    rm /tmp/patch_contact_names.py

FROM golang:1.25-trixie AS go_builder

RUN apt-get update -y && \
    apt-get install -y --no-install-recommends libmupdf-dev && \
    rm -rf /var/lib/apt/lists/*

COPY --from=patched /usr/local/include/python3.13 /usr/local/include/python3.13
COPY --from=patched /usr/local/lib/libpython3.13.so.1.0 /usr/local/lib/libpython3.13.so.1.0
RUN ln -s libpython3.13.so.1.0 /usr/local/lib/libpython3.13.so

COPY --from=patched /venv/lib/python3.13/site-packages/slidge_whatsapp /src/slidge_whatsapp
COPY bridge_contact_name_event_test.go /src/slidge_whatsapp/contact_name_event_test.go
COPY bridge_contact_name_store_test.go /src/slidge_whatsapp/contact_name_store_test.go
COPY gopy_whatsapp_exports.map /tmp/gopy_whatsapp_exports.map

WORKDIR /src/slidge_whatsapp
RUN gofmt -w event.go contact_name_event_test.go contact_name_store_test.go && \
    go test . && \
    cd generated && \
    go build -buildmode=c-shared -tags "mupdf extlib" \
        -ldflags="-s -w -extldflags=-Wl,--version-script=/tmp/gopy_whatsapp_exports.map" \
        -o _whatsapp.cpython-313-x86_64-linux-gnu.so .

FROM patched

COPY --from=go_builder \
    /src/slidge_whatsapp/generated/_whatsapp.cpython-313-x86_64-linux-gnu.so \
    /venv/lib/python3.13/site-packages/slidge_whatsapp/generated/_whatsapp.cpython-313-x86_64-linux-gnu.so
COPY smoke_bridge_contact_names_runtime.py /tmp/smoke_contact_names.py
RUN python -B /tmp/smoke_contact_names.py && rm /tmp/smoke_contact_names.py
USER slidge
