[Unit]
Description=Puente local de WhatsApp CAN
Requires=prosody.service
After=prosody.service network.target
ConditionPathExists=/etc/whatsapp-can-bridge/environment

[Service]
Type=simple
ExecStartPre=-/usr/bin/podman rm -f whatsapp-can-slidge
ExecStart=/usr/bin/podman run --rm --name whatsapp-can-slidge --pull=never --network host --env-file /etc/whatsapp-can-bridge/environment -v /var/lib/whatsapp-can-bridge/slidge:/var/lib/slidge -v /var/lib/whatsapp-can-bridge/attachments:/var/lib/slidge-attachments ghcr.io/marcomolinaleija/cliente-xmpp-bridge:v14
ExecStop=/usr/bin/podman stop --time 30 whatsapp-can-slidge
Restart=on-failure
RestartSec=5
TimeoutStartSec=0
TimeoutStopSec=45

[Install]
WantedBy=multi-user.target
