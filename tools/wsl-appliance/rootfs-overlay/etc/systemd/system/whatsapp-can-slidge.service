[Unit]
Description=Puente local de WhatsApp CAN
Requires=prosody.service
After=prosody.service network.target
ConditionPathExists=/etc/whatsapp-can-bridge/environment

[Service]
Type=simple
ExecStartPre=-/usr/bin/podman rm -f whatsapp-can-slidge
ExecStart=/usr/local/libexec/whatsapp-can-bridge-image run
ExecStop=/usr/bin/podman stop --time 30 whatsapp-can-slidge
Restart=on-failure
RestartSec=5
TimeoutStartSec=0
TimeoutStopSec=45

[Install]
WantedBy=multi-user.target
